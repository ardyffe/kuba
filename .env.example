# Credenziali usate dal docker-compose per creare il container Postgres
POSTGRES_USER=kuba
POSTGRES_PASSWORD=kuba
POSTGRES_DB=kuba

# Stringa di connessione usata dal backend Rust (deve combaciare con le tre righe sopra)
DATABASE_URL=postgres://kuba:kuba@localhost:5432/kuba

# Porta del server HTTP (opzionale, default 3000)
PORT=3000

# Chiave per l'API Claude, obbligatoria da M4 (estrazione delle fatture)
ANTHROPIC_API_KEY=

# Modello usato per l'estrazione (opzionale, default claude-haiku-4-5).
# Scala dal piu' economico al piu' accurato, da decidere misurando:
#   claude-haiku-4-5  ~$0.014 a fattura
#   claude-sonnet-5   ~$0.027
#   claude-opus-5     ~$0.13
ANTHROPIC_MODEL=claude-haiku-4-5
