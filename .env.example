# Credenziali usate dal docker-compose per creare il container Postgres
POSTGRES_USER=kuba
POSTGRES_PASSWORD=kuba
POSTGRES_DB=kuba

# Stringa di connessione usata dal backend Rust (deve combaciare con le tre righe sopra)
DATABASE_URL=postgres://kuba:kuba@localhost:5432/kuba

# Porta del server HTTP (opzionale, default 3000)
PORT=3000

# Chiave per l'API Claude, servira' da M4 (estrazione delle fatture)
ANTHROPIC_API_KEY=
